# Copy to .env and fill in. .env is git-ignored. Never commit it.

# Hugging Face user name (datasets and policies are pushed under this name)
HF_USER=your_hf_username

# USB serial ports of the two Waveshare driver boards. Find them with:
#   .venv/bin/lerobot-find-port
FOLLOWER_PORT=/dev/tty.usbmodemXXXX
LEADER_PORT=/dev/tty.usbmodemYYYY

# Robot ids. LeRobot names the calibration files after these.
FOLLOWER_ID=follower_a
LEADER_ID=leader_a
